<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="co.edu.uniquindio.poo.controller.PaquetesController">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15" />
            </padding>
            <Label text="Gestion de paquetes" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label
                text="Los componentes pueden ser actividades o paquetes ya registrados. Separe los codigos con coma." />
            <GridPane hgap="10" vgap="8">
                <Label text="Codigo" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="3" />
                <Label text="Descuento (%)" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="txtDescuento" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Codigos componentes" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <TextField fx:id="txtComponentes" promptText="A01, A02 o P01, A03"
                    GridPane.rowIndex="1" GridPane.columnIndex="3" />
            </GridPane>
            <HBox spacing="12">
                <Button text="Registrar paquete" onAction="#registrar" />
                <Label fx:id="lblMensaje" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tblPaquetes">
            <columns>
                <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="90" />
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180" />
                <TableColumn fx:id="colDescuento" text="Descuento %" prefWidth="100" />
                <TableColumn fx:id="colPrecio" text="Precio/persona" prefWidth="130" />
                <TableColumn fx:id="colDuracion" text="Duracion h" prefWidth="100" />
                <TableColumn fx:id="colActividades" text="Actividades incluidas" prefWidth="500" />
            </columns>
            <BorderPane.margin>
                <Insets top="10" right="15" bottom="15" left="15" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>